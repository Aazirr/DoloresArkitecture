# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical site URL — no trailing slash (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://doloresarkitecture.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified sender domain in Resend
# Format: Display Name <address@yourdomain.com>
CONTACT_FROM_EMAIL=D.ARK+ Website <noreply@doloresarkitecture.com>
# Where inquiry emails are delivered (the firm inbox)
CONTACT_TO_EMAIL=info@darkplus.studio

# ─── Spam protection (Cloudflare Turnstile — optional upgrade) ────────────────
# Get keys from https://dash.cloudflare.com → Turnstile
# Leave blank to rely on the honeypot field only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

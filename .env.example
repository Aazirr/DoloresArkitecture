# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical site URL — no trailing slash (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified sender domain in Resend
CONTACT_FROM_EMAIL=hello@your-domain.com
# Where inquiry emails are delivered
CONTACT_TO_EMAIL=kenneth@your-domain.com

# ─── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
# Get keys from https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x000000000000000000000
TURNSTILE_SECRET_KEY=0x000000000000000000000
